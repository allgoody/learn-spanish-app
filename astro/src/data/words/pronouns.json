        { "es": "contigo", "ipa": "/konˈtiɣo/", "pos": "pron. pers. (prep.)", "ru": "с тобой", "example": { "es": "Quiero hablar contigo.", "ru": "Я хочу поговорить с тобой." }, "grammar": "2-е лицо, ед. ч.", "note": "слитная форма: con + ti" },
        { "es": "consigo", "ipa": "/konˈsiɣo/", "pos": "pron. pers. (prep.)", "ru": "с собой", "example": { "es": "Lleva el pasaporte consigo.", "ru": "Он носит паспорт с собой." }, "grammar": "3-е лицо", "note": "слитная форма: con + sí" }
