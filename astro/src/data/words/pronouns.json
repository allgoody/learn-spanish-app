        { "es": "mí", "ipa": "/mi/", "pos": "pron. pers. (prep.)", "ru": "меня", "example": { "es": "Esto es para mí.", "ru": "Это для меня." }, "grammar": "1-е лицо, ед. ч.", "note": "после предлога: para mí" },
        { "es": "ti", "ipa": "/ti/", "pos": "pron. pers. (prep.)", "ru": "тебя", "example": { "es": "El regalo es para ti.", "ru": "Подарок для тебя." }, "grammar": "2-е лицо, ед. ч.", "note": "после предлога: para ti" },
        { "es": "sí", "ipa": "/si/", "pos": "pron. pers. (prep.)", "ru": "себя", "example": { "es": "Lo hizo por sí mismo.", "ru": "Он сделал это сам." }, "grammar": "3-е лицо", "note": "после предлога: para sí" },
