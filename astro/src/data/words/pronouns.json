        { "es": "nosotras", "ipa": "/noˈsotɾas/", "pos": "pron. pers.", "ru": "мы", "example": { "es": "Nosotras somos hermanas.", "ru": "Мы сёстры." }, "grammar": "1-е лицо, мн. ч., ж. р.", "note": "только о женщинах" },
