        { "es": "mío / mía / míos / mías", "ipa": "/ˈmi.o/ /ˈmi.a/ /ˈmi.os/ /ˈmi.as/", "pos": "pron. poses.", "ru": "мой (полная форма)", "example": { "es": "Este libro es mío.", "ru": "Эта книга моя." }, "grammar": "1-е лицо, ед. ч.", "note": "un amigo mío" },
