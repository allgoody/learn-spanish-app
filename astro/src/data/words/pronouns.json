        { "es": "las", "ipa": "/las/", "pos": "pron. pers. (acus.)", "ru": "их", "example": { "es": "Las leo por la noche.", "ru": "Я читаю их по вечерам." }, "grammar": "3-е лицо, мн. ч., ж. р.", "note": "также вежливое «Вас» (мн. ч., ж. р.)" }
