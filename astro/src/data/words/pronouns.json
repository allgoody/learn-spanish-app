        { "es": "ellas", "ipa": "/ˈeʝas/", "pos": "pron. pers.", "ru": "они", "example": { "es": "Ellas compran pan.", "ru": "Они покупают хлеб." }, "grammar": "3-е лицо, мн. ч., ж. р.", "note": null }
