        { "es": "vosotras", "ipa": "/boˈsotɾas/", "pos": "pron. pers.", "ru": "вы", "example": { "es": "Vosotras estudiáis juntas.", "ru": "Вы учитесь вместе." }, "grammar": "2-е лицо, мн. ч., ж. р.", "note": "только в Испании" },
        { "es": "ustedes", "ipa": "/usˈteðes/", "pos": "pron. pers.", "ru": "вы; Вы (вежл. мн.)", "example": { "es": "Ustedes pueden entrar.", "ru": "Вы можете войти." }, "grammar": "3-е лицо, мн. ч.", "note": "в Испании — только вежливое мн. ч.; в Латинской Америке заменяет vosotros" },
