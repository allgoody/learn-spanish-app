        { "es": "la", "ipa": "/la/", "pos": "pron. pers. (acus.)", "ru": "её", "example": { "es": "La conozco bien.", "ru": "Я её хорошо знаю." }, "grammar": "3-е лицо, ед. ч., ж. р.", "note": "в Испании также вежливое «Вас» (ж. р.)" },
