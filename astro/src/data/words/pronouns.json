{
  "id": "pronouns",
  "lang": "es",
  "title": { "ru": "Местоимения", "en": "Pronouns" },
  "groups": [
    {
      "title": "Личные (подлежащее)",
      "items": [
        { "es": "yo", "ipa": "/ʝo/", "pos": "pron. pers.", "ru": "я", "example": { "es": "Yo hablo español.", "ru": "Я говорю по-испански." }, "grammar": "1-е лицо, ед. ч.", "note": null },
        { "es": "tú", "ipa": "/tu/", "pos": "pron. pers.", "ru": "ты", "example": { "es": "Tú tienes razón.", "ru": "Ты прав." }, "grammar": "2-е лицо, ед. ч.", "note": null },
        { "es": "vos", "ipa": "/bos/", "pos": "pron. pers.", "ru": "ты", "example": { "es": "Vos sabés la respuesta.", "ru": "Ты знаешь ответ." }, "grammar": "2-е лицо, ед. ч.", "note": "voseo: употребляется в Аргентине, Уругвае и др. вместо tú" },
