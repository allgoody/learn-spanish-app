{
  "id": "adverbs",
  "lang": "es",
  "title": { "ru": "Наречия", "en": "Adverbs" },
  "groups": [
    {
      "title": "Места",
      "items": [
        { "es": "aquí", "ipa": "/aˈki/", "pos": "adv.", "ru": "здесь, сюда", "example": { "es": "Ven aquí.", "ru": "Иди сюда." }, "grammar": "место; ближе к говорящему, чем allí", "note": null },
        { "es": "acá", "ipa": "/aˈka/", "pos": "adv.", "ru": "сюда", "example": { "es": "Ven acá.", "ru": "Иди сюда." }, "grammar": "сюда; употребительно в Латинской Америке", "note": "разговорное" },
        { "es": "ahí", "ipa": "/aˈi/", "pos": "adv.", "ru": "там, туда", "example": { "es": "Ponlo ahí.", "ru": "Положи это туда." }, "grammar": "место; рядом с собеседником", "note": null },
        { "es": "allí", "ipa": "/aˈʝi/", "pos": "adv.", "ru": "там", "example": { "es": "Está allí.", "ru": "Это там." }, "grammar": "место; дальше от говорящего", "note": null },
        { "es": "allá", "ipa": "/aˈʝa/", "pos": "adv.", "ru": "туда, там", "example": { "es": "Vamos allá.", "ru": "Пойдём туда." }, "grammar": "туда; менее конкретно, чем allí", "note": null },
        { "es": "cerca", "ipa": "/ˈseɾka/", "pos": "adv.", "ru": "близко, рядом", "example": { "es": "Vive cerca.", "ru": "Он живёт близко." }, "grammar": "близко; cerca de + сущ.", "note": null },
        { "es": "lejos", "ipa": "/ˈlexos/", "pos": "adv.", "ru": "далеко", "example": { "es": "Está lejos.", "ru": "Это далеко." }, "grammar": "далеко; lejos de + сущ.", "note": null },
        { "es": "arriba", "ipa": "/aˈriβa/", "pos": "adv.", "ru": "вверху, наверх", "example": { "es": "Mira arriba.", "ru": "Посмотри наверх." }, "grammar": "вверху, наверх", "note": null },
        { "es": "abajo", "ipa": "/aˈbaxo/", "pos": "adv.", "ru": "внизу, вниз", "example": { "es": "El sótano está abajo.", "ru": "Подвал внизу." }, "grammar": "внизу, вниз", "note": null },
        { "es": "dentro", "ipa": "/ˈdentɾo/", "pos": "adv.", "ru": "внутри", "example": { "es": "Está dentro.", "ru": "Это внутри." }, "grammar": "внутри; dentro de + сущ.", "note": null },
        { "es": "fuera", "ipa": "/ˈfweɾa/", "pos": "adv.", "ru": "снаружи, вне", "example": { "es": "Espera fuera.", "ru": "Жди снаружи." }, "grammar": "снаружи; fuera de + сущ.", "note": null },
        { "es": "adentro", "ipa": "/aˈdentɾo/", "pos": "adv.", "ru": "внутрь", "example": { "es": "Vamos adentro.", "ru": "Пойдём внутрь." }, "grammar": "внутрь; употребительно в Латинской Америке", "note": null },
        { "es": "afuera", "ipa": "/aˈfweɾa/", "pos": "adv.", "ru": "наружу", "example": { "es": "Sal afuera.", "ru": "Выйди наружу." }, "grammar": "наружу; разговорное", "note": "разговорное" },
        { "es": "delante", "ipa": "/deˈlante/", "pos": "adv.", "ru": "впереди, спереди", "example": { "es": "Siéntate delante.", "ru": "Сядь впереди." }, "grammar": "впереди; delante de + сущ.", "note": null },
        { "es": "detrás", "ipa": "/deˈtɾas/", "pos": "adv.", "ru": "позади, сзади", "example": { "es": "Está detrás.", "ru": "Это позади." }, "grammar": "позади; detrás de + сущ.", "note": null },
        { "es": "encima", "ipa": "/enˈsima/", "pos": "adv.", "ru": "сверху, наверху", "example": { "es": "Ponlo encima.", "ru": "Положи сверху." }, "grammar": "сверху; encima de + сущ.", "note": null },
        { "es": "debajo", "ipa": "/deˈbaxo/", "pos": "adv.", "ru": "внизу, под", "example": { "es": "Debajo hay agua.", "ru": "Внизу есть вода." }, "grammar": "внизу; debajo de + сущ.", "note": null },
        { "es": "enfrente", "ipa": "/emˈfɾente/", "pos": "adv.", "ru": "напротив", "example": { "es": "Vive enfrente.", "ru": "Он живёт напротив." }, "grammar": "напротив; enfrente de + сущ.", "note": null },
        { "es": "junto", "ipa": "/ˈxunto/", "pos": "adv.", "ru": "рядом, вместе", "example": { "es": "Estamos junto al río.", "ru": "Мы у реки." }, "grammar": "рядом; junto a + сущ.", "note": null },
        { "es": "alrededor", "ipa": "/alreðeˈðoɾ/", "pos": "adv.", "ru": "вокруг", "example": { "es": "Miró alrededor.", "ru": "Он огляделся вокруг." }, "grammar": "вокруг; alrededor de + сущ.", "note": null },
        { "es": "acullá", "ipa": "/akuˈʝa/", "pos": "adv.", "ru": "вон там", "example": { "es": "Acullá se ve el monte.", "ru": "Вон там видна гора." }, "grammar": "вон там; книжное", "note": "устарелое" },
        { "es": "dondequiera", "ipa": "/dondeˈkjeɾa/", "pos": "adv.", "ru": "где бы ни, везде", "example": { "es": "Dondequiera que vayas, te espero.", "ru": "Куда бы ты ни пошёл, я тебя жду." }, "grammar": "где бы ни; книжное", "note": null }
      ]
