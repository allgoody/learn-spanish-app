        { "es": "pasado mañana", "ipa": "/paˈsaðo maˈɲana/", "pos": "adv.", "ru": "послезавтра", "example": { "es": "Pasado mañana llega.", "ru": "Послезавтра он приезжает." }, "grammar": "через день после сегодня", "note": null },
