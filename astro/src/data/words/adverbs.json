        { "es": "próximamente", "ipa": "/ˈpɾoksimaˈmente/", "pos": "adv.", "ru": "в ближайшее время", "example": { "es": "Próximamente habrá cambios.", "ru": "В ближайшее время будут перемены." }, "grammar": "в ближайшее время", "note": null }
