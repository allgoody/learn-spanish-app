        { "es": "a", "ipa": "/a/", "pos": "prep.", "ru": "в, к, на", "example": { "es": "Voy a Madrid.", "ru": "Я еду в Мадрид." }, "grammar": "направление, время; a + сущ./инф.", "note": null },
