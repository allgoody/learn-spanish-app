    {
      "title": "ser vs estar — значение меняется",
      "items": [
        { "es": "ser listo / estar listo", "ipa": "/seɾ ˈlisto/ /esˈtaɾ ˈlisto/", "pos": "v. (ser/estar)", "ru": "быть умным / быть готовым", "example": { "es": "Es listo, pero hoy no está listo. / Él es listo y ahora está listo.", "ru": "Он умный, но сегодня не готов. / Он умный и сейчас готов." }, "grammar": "ser: умный от природы; estar: готовый", "note": null },
        { "es": "ser aburrido / estar aburrido", "ipa": "/seɾ aβuˈriðo/ /esˈtaɾ aβuˈriðo/", "pos": "v. (ser/estar)", "ru": "быть скучным / скучать", "example": { "es": "El libro es aburrido y estoy aburrido. / El libro es aburrido, yo estoy aburrido.", "ru": "Книга скучная, и мне скучно. / Книга скучная, а я скучаю." }, "grammar": "ser: скучный (свойство); estar: скучающий", "note": null },
        { "es": "ser rico / estar rico", "ipa": "/seɾ ˈriko/ /esˈtaɾ ˈriko/", "pos": "v. (ser/estar)", "ru": "быть богатым / быть вкусным", "example": { "es": "Es rico y la sopa está rica. / Él es rico, la sopa está rica.", "ru": "Он богат, и суп вкусный. / Он богат, а суп вкусный." }, "grammar": "ser: богатый; estar: вкусный", "note": null },
        { "es": "ser verde / estar verde", "ipa": "/seɾ ˈbeɾðe/ /esˈtaɾ ˈbeɾðe/", "pos": "v. (ser/estar)", "ru": "быть зелёным / быть незрелым", "example": { "es": "El campo es verde y la fruta está verde. / El campo es verde, la fruta está verde.", "ru": "Поле зелёное, а фрукт незрелый. / Поле зелёное, фрукт незрелый." }, "grammar": "ser: зелёный (цвет); estar: незрелый", "note": null },
        { "es": "ser bueno / estar bueno", "ipa": "/seɾ ˈbweno/ /esˈtaɾ ˈbweno/", "pos": "v. (ser/estar)", "ru": "быть хорошим / быть в форме; вкусным", "example": { "es": "Es bueno y está bueno. / Él es bueno, el pan está bueno.", "ru": "Он хороший человек и хорош собой. / Он добрый, а хлеб вкусный." }, "grammar": "ser: хороший (мораль); estar: в форме, вкусный", "note": null },
        { "es": "ser malo / estar malo", "ipa": "/seɾ ˈmalo/ /esˈtaɾ ˈmalo/", "pos": "v. (ser/estar)", "ru": "быть плохим / быть больным", "example": { "es": "El perro es malo y está malo. / El perro es malo, el niño está malo.", "ru": "Собака злая и больна. / Собака злая, а ребёнок болен." }, "grammar": "ser: плохой, злой; estar: больной", "note": null },
        { "es": "ser vivo / estar vivo", "ipa": "/seɾ ˈbiβo/ /esˈtaɾ ˈbiβo/", "pos": "v. (ser/estar)", "ru": "быть смышлёным / быть живым", "example": { "es": "Es vivo y todavía está vivo. / Él es vivo, el abuelo está vivo.", "ru": "Он смышлёный и всё ещё жив. / Он смышлёный, а дед жив." }, "grammar": "ser: живой, смышлёный; estar: в живых", "note": null },
        { "es": "ser seguro / estar seguro", "ipa": "/seɾ seˈɣuɾo/ /esˈtaɾ seˈɣuɾo/", "pos": "v. (ser/estar)", "ru": "быть безопасным / быть уверенным", "example": { "es": "El coche es seguro y estoy seguro. / El coche es seguro, yo estoy seguro.", "ru": "Машина безопасная, и я уверен. / Машина безопасная, а я уверен." }, "grammar": "ser: безопасный, надёжный; estar: уверенный", "note": null },
        { "es": "ser atento / estar atento", "ipa": "/seɾ aˈtento/ /esˈtaɾ aˈtento/", "pos": "v. (ser/estar)", "ru": "быть внимательным (по характеру) / быть внимательным (сейчас)", "example": { "es": "Es atento y está atento a todo. / Él es atento, ahora está atento.", "ru": "Он внимательный человек и сейчас ко всему внимателен. / Он внимательный, сейчас он сосредоточен." }, "grammar": "ser: внимательный (черта); estar: сосредоточенный сейчас", "note": null },
        { "es": "ser cansado / estar cansado", "ipa": "/seɾ kanˈsado/ /esˈtaɾ kanˈsado/", "pos": "v. (ser/estar)", "ru": "быть утомительным / быть уставшим", "example": { "es": "El viaje es cansado y estoy cansado. / El viaje es cansado, yo estoy cansado.", "ru": "Поездка утомительная, и я устал. / Поездка утомительная, а я устал." }, "grammar": "ser: утомительный; estar: уставший", "note": null }
      ]
