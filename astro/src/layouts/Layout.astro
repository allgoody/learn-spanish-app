---
import '../styles/global.css'
import LangToggle from '../components/LangToggle.tsx'

interface Props {
  title?: string
}

const { title = 'Aprende español' } = Astro.props
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-stone-900">
    <header class="border-b border-stone-200">
      <div class="max-w-2xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="font-bold text-lg hover:text-amber-700">Aprende español</a>
        <LangToggle client:load />
      </div>
    </header>
    <slot />
    <footer class="border-t border-stone-200 mt-12">
      <div class="max-w-2xl mx-auto px-4 py-6 text-center">
        <a
          href="https://ctdev.dev/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[0.65rem] text-stone-500 opacity-60 hover:opacity-100 hover:underline"
        >Made by CTDev</a>
      </div>
    </footer>
  </body>
</html>
