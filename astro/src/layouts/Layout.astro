---
import '../styles/global.css'
import HeaderMenu from '../components/HeaderMenu.tsx'

interface Props {
  title?: string
}

const { title = 'Aprende español' } = Astro.props
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Aprende español leyendo «Andanzas y visiones españolas» de Miguel de Unamuno, con glosario integrado." />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:image" content="/og.png" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme')
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t)
          }
          var l = localStorage.getItem('lang')
          if (l === 'ru' || l === 'en') {
            document.documentElement.lang = l
          }
        } catch (e) {}
      })()
    </script>
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <header class="border-b border-line">
      <div class="max-w-2xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="font-bold text-lg hover:text-accent">Aprende español</a>
        <HeaderMenu client:load />
      </div>
    </header>
    <slot />
    <footer class="border-t border-line mt-12">
      <div class="max-w-2xl mx-auto px-4 py-6 text-center">
        <a
          href="https://ctdev.dev/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[0.65rem] text-muted hover:underline"
        >Made by CTDev</a>
      </div>
    </footer>
  </body>
</html>
