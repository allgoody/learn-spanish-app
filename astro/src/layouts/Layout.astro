---
import '../styles/global.css'
import HeaderMenu from '../components/HeaderMenu.tsx'
import { seo, seoLang } from '../lib/seo'

interface Props {
  title?: string
  description?: string
  contentLang?: string
}

const { title = seo[seoLang].homeTitle, description = seo[seoLang].homeDescription, contentLang } = Astro.props
---

<html lang={contentLang ?? 'es'} data-content-lang={contentLang ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:image" content="/og.jpg" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme')
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t)
          }
          if (!document.documentElement.hasAttribute('data-content-lang')) {
            var l = localStorage.getItem('lang')
            if (l === 'ru') {
              document.documentElement.lang = l
            }
          }
        } catch (e) {}
      })()
    </script>
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <header class="border-b border-line">
      <div class="max-w-2xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="font-bold text-lg hover:text-accent">Aprende español</a>
        <HeaderMenu client:load />
      </div>
    </header>
    <slot />
    <footer class="border-t border-line mt-12">
      <div class="max-w-2xl mx-auto px-4 py-6 text-center">
        <a
          href="https://ctdev.dev/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[0.65rem] text-muted hover:underline"
        >Made by CTDev</a>
      </div>
    </footer>
  </body>
</html>
