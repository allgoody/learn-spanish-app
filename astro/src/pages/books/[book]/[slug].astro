---
import Layout from '../../../layouts/Layout.astro'
import Reader from '../../../components/Reader.tsx'
import { books } from '../../../lib/books'
import { seo, seoLang } from '../../../lib/seo'
import type { Token, GlossLibrary } from '../../../lib/types'

export function getStaticPaths() {
  // globs must live here: getStaticPaths runs in its own scope and can only
  // reference file imports, not frontmatter variables
  const tokenFiles = import.meta.glob('../../../data/books/*/tokens/*.json', {
    eager: true,
    import: 'default',
  })
  const glossFiles = import.meta.glob('../../../data/books/*/glosses/*.json', {
    eager: true,
    import: 'default',
  })
  return books.flatMap((book) =>
    book.chapters.map((c) => ({
      params: { book: book.id, slug: c.id },
      props: {
        book,
        chapter: c,
        tokens: tokenFiles[`../../../data/books/${book.id}/tokens/${c.id}.json`] as Token[],
        glosses: glossFiles[`../../../data/books/${book.id}/glosses/${c.id}.json`] as GlossLibrary,
      },
    })),
  )
}

// 2+ consecutive \n tokens = paragraph break; single \n = soft line wrap → space
function splitParagraphs(tokens: Token[]): Token[][] {
  const paras: Token[][] = []
  let cur: Token[] = []
  let i = 0
  while (i < tokens.length) {
    if (tokens[i].t === '\n') {
      let n = 0
      while (i < tokens.length && tokens[i].t === '\n') {
        n++
        i++
      }
      if (n >= 2) {
        if (cur.length) {
          paras.push(cur)
          cur = []
        }
      } else {
        cur.push({ t: ' ', w: null })
      }
    } else {
      cur.push(tokens[i])
      i++
    }
  }
  if (cur.length) paras.push(cur)
  return paras
}

const { book, chapter, tokens, glosses } = Astro.props
const s = seo[seoLang]
const paragraphs = splitParagraphs(tokens)
const idx = book.chapters.findIndex((c) => c.id === chapter.id)
const prev = idx > 0 ? book.chapters[idx - 1] : null
const next = idx < book.chapters.length - 1 ? book.chapters[idx + 1] : null
---

<Layout title={s.chapterTitle(book, chapter)} description={s.chapterDescription(book, chapter)} contentLang={book.lang}>
  <article class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">{chapter.title}</h1>
    {paragraphs.map((para) => (
      <p class="text-lg leading-relaxed text-ink mb-4">
        {para.map((tok) =>
          tok.w ? (
            <span class="glossable" data-word={tok.w} tabindex="0" role="button">
              {tok.t}
            </span>
          ) : (
            tok.t
          ),
        )}
      </p>
    ))}
    <nav class="mt-10 flex justify-between text-sm">
      {prev ? (
        <a href={`/books/${book.id}/${prev.id}`} class="hover:text-accent">
          ← {prev.title}
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a href={`/books/${book.id}/${next.id}`} class="hover:text-accent">
          {next.title} →
        </a>
      ) : (
        <span />
      )}
    </nav>
    <div class="mt-6 text-center">
      <a href={`/books/${book.id}/`} class="text-sm text-muted hover:text-accent">
        ← {book.title}
      </a>
    </div>
  </article>
  <Reader glosses={glosses} client:load />
</Layout>
