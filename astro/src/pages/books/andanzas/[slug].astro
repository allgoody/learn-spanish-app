---
import Layout from '../../../layouts/Layout.astro'
import Reader from '../../../components/Reader.tsx'
import meta from '../../../data/books/andanzas/meta.json'
import type { Token, GlossLibrary } from '../../../lib/types'

export function getStaticPaths() {
  // globs must live here: getStaticPaths runs in its own scope and can only
  // reference file imports, not frontmatter variables
  const tokenFiles = import.meta.glob('../../../data/books/andanzas/tokens/*.json', {
    eager: true,
    import: 'default',
  })
  const glossFiles = import.meta.glob('../../../data/books/andanzas/glosses/*.json', {
    eager: true,
    import: 'default',
  })
  return meta.chapters.map((c) => ({
    params: { slug: c.id },
    props: {
      chapter: c,
      tokens: tokenFiles[`../../../data/books/andanzas/tokens/${c.id}.json`] as Token[],
      glosses: glossFiles[`../../../data/books/andanzas/glosses/${c.id}.json`] as GlossLibrary,
    },
  }))
}

// 2+ consecutive \n tokens = paragraph break; single \n = soft line wrap → space
function splitParagraphs(tokens: Token[]): Token[][] {
  const paras: Token[][] = []
  let cur: Token[] = []
  let i = 0
  while (i < tokens.length) {
    if (tokens[i].t === '\n') {
      let n = 0
      while (i < tokens.length && tokens[i].t === '\n') {
        n++
        i++
      }
      if (n >= 2) {
        if (cur.length) {
          paras.push(cur)
          cur = []
        }
      } else {
        cur.push({ t: ' ', w: null })
      }
    } else {
      cur.push(tokens[i])
      i++
    }
  }
  if (cur.length) paras.push(cur)
  return paras
}

const { chapter, tokens, glosses } = Astro.props
const paragraphs = splitParagraphs(tokens)
const idx = meta.chapters.findIndex((c) => c.id === chapter.id)
const prev = idx > 0 ? meta.chapters[idx - 1] : null
const next = idx < meta.chapters.length - 1 ? meta.chapters[idx + 1] : null
---

<Layout title={chapter.title}>
  <article class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">{chapter.title}</h1>
    {paragraphs.map((para) => (
      <p class="text-lg leading-relaxed text-stone-800 mb-4">
        {para.map((tok) =>
          tok.w ? (
            <span class="glossable" data-word={tok.w} tabindex="0" role="button">
              {tok.t}
            </span>
          ) : (
            tok.t
          ),
        )}
      </p>
    ))}
    <nav class="mt-10 flex justify-between text-sm">
      {prev ? (
        <a href={`/books/andanzas/${prev.id}`} class="hover:text-amber-700">
          ← {prev.title}
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a href={`/books/andanzas/${next.id}`} class="hover:text-amber-700">
          {next.title} →
        </a>
      ) : (
        <span />
      )}
    </nav>
    <div class="mt-6 text-center">
      <a href="/" class="text-sm text-stone-500 hover:text-amber-700">
        ← Home
      </a>
    </div>
  </article>
  <Reader glosses={glosses} client:load />
</Layout>
