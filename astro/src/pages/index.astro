---
import Layout from '../layouts/Layout.astro'
import Chooser from '../components/Chooser.tsx'
import { books } from '../lib/books'
import { categories } from '../lib/words'
import JsonLd from '../components/JsonLd.astro'
import { seo, seoLang } from '../lib/seo'

const s = seo[seoLang]
---

<Layout title={s.homeTitle} description={s.homeDescription} contentLang="ru">
  <JsonLd
    schema={{
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Aprende español',
      url: 'https://learn-words-5mq.pages.dev/',
      inLanguage: 'ru',
    }}
  />
  <JsonLd
    schema={{
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Aprende español',
      url: 'https://learn-words-5mq.pages.dev/',
    }}
  />
  <main class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">Aprende español</h1>
    <Chooser books={books} categories={categories} client:load />
  </main>
</Layout>
